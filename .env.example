# ===================================================================
# .env.example —— 环境变量模板（step14）
# 使用方法：复制本文件为 .env，并填入真实值。不要把 .env 提交到 Git！
# 后端自动从工作区根目录的 .env 读取（见 backend/config.py）。
# ===================================================================

# ---------- 大模型（第13/14步）----------
# 默认指向 DeepSeek（中文表现好，有免费额度/试用额度）。
# 切换其它 OpenAI 兼容接口：改 LLM_BASE_URL 与 LLM_MODEL 即可。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------- MySQL（第15步，注册/登录用）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=zhiyuan

# ---------- 应用安全（第15步 JWT）----------
# 生产环境请用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
APP_SECRET_KEY=change-me-in-prod-something-long-and-random
JWT_EXPIRE_MINUTES=10080
